# Окружение для развёртывания на сервер.
#
# Скопируйте в deploy/.env и заполните. Файл не коммитится.
#   cp deploy/env.server.example deploy/.env
#
# Значения DATABASE_URI, MEDIA_DIR и PORT задаются в docker-compose.server.yml
# и здесь не нужны — их всё равно перекроет compose.

# ── Обязательное ─────────────────────────────────────────────────────────────

# Публичный адрес в punycode. Должен совпадать с тем, по которому реально
# открывается сайт, иначе админка перестанет сохранять данные (CORS/CSRF).
NEXT_PUBLIC_SITE_URL=https://xn--80ajwod0cujx.xn--p1ai

# openssl rand -hex 32
PAYLOAD_SECRET=

# openssl rand -hex 24
PREVIEW_SECRET=

# Пароль базы. Генерируется один раз при первом запуске контейнера postgres;
# менять после инициализации тома нельзя без пересоздания базы.
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Необязательное ───────────────────────────────────────────────────────────

POSTGRES_USER=greymouse
POSTGRES_DB=greymouse

# Порт на localhost, который слушает контейнер. На сервере заняты 3000, 3001, 4000.
APP_PORT=3002

# Ограничение памяти контейнера приложения.
APP_MEMORY_LIMIT=1g

# Первый администратор (нужен один раз, для scripts/create-admin.ts).
# Пароль не короче 12 символов.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── S3-хранилище (опционально) ───────────────────────────────────────────────
# Пока эти поля пусты, файлы лежат в томе greymouse-media — этого достаточно
# для одного экземпляра приложения. Заполните, если понадобится вынести
# загрузки в MinIO или другое S3-совместимое хранилище.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_S3_PUBLIC_URL=

# ── Прочее ───────────────────────────────────────────────────────────────────

# Ограничение частоты отправки формы (по умолчанию 5 заявок за 10 минут).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=600000

# Уведомления о заявках. Без SMTP заявки всё равно сохраняются в админке.
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Аналитика. Пусто — скрипт не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

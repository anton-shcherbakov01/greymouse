# ─────────────────────────────────────────────────────────────
# Скопируйте файл в .env и заполните реальными значениями.
# .env в репозиторий не коммитится.
# ─────────────────────────────────────────────────────────────

# Базовый URL сайта. Используется для canonical, sitemap, OG и preview.
# Для production основного домена (IDN) укажите punycode-форму —
# сераямышь.рф → xn--80apaghdkxi3f.xn--p1ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секрет Payload: подпись JWT и шифрование полей. Минимум 32 случайных символа.
# Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=

# Строка подключения к PostgreSQL.
# Локально через docker compose: postgres://greymouse:greymouse@localhost:5432/greymouse
DATABASE_URI=

# Секрет для draft-preview из админки (ссылка «Предпросмотр»).
# Сгенерировать: openssl rand -hex 24
PREVIEW_SECRET=

# ── Первый администратор (используется только скриптом create-admin) ──
# Скрипт не запускается без этих значений; дефолтного пароля в коде нет.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── S3-совместимое хранилище для production-загрузок ──
# Если S3_BUCKET пуст, Payload использует локальную файловую систему (dev).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true для S3-совместимых сервисов (MinIO, Selectel, Yandex Object Storage и т. п.)
S3_FORCE_PATH_STYLE=false
# Публичный базовый URL бакета/CDN — попадёт в next/image remotePatterns
NEXT_PUBLIC_S3_PUBLIC_URL=

# ── Аналитика (опционально) ──
# Пустые значения = скрипты аналитики не подключаются
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ── Формы ──
# Куда отправлять заявки с формы контактов. Если пусто — заявки только
# сохраняются в коллекцию `enquiries` в админке.
CONTACT_NOTIFY_EMAIL=

# Ограничение частоты отправки формы: сколько заявок с одного IP за окно.
# Значения по умолчанию — 5 заявок за 10 минут.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=600000

# SMTP для писем-уведомлений (опционально; без него письма не отправляются)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
